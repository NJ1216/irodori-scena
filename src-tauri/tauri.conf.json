{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "irodori SCENA",
  "version": "26.11.24",
  "identifier": "com.irodori-scena",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev:web --mode tauri --host 127.0.0.1 --port 5175 --strictPort",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "node tools/verify-tauri-release-build.mjs && pnpm build",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:5175/?scena-tauri=1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "irodori SCENA",
        "width": 1440,
        "height": 960,
        "minWidth": 1280,
        "minHeight": 900,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:5175; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["scena"],
        "name": "SCENA Project",
        "description": "irodori SCENA プロジェクト",
        "role": "Editor",
        "rank": "Alternate",
        "exportedType": { "identifier": "com.irodori-scena.project", "conformsTo": ["public.data"] }
      },
      {
        "ext": ["scenacast"],
        "name": "SCENA Cast",
        "description": "irodori SCENA キャスト",
        "role": "Viewer",
        "rank": "Alternate",
        "exportedType": { "identifier": "com.irodori-scena.cast", "conformsTo": ["public.data"] }
      }
    ],
    "resources": {
      "resources/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings"
    }
  }
}
